# --- Airbyte (abctl local, voir README) ---
AIRBYTE_HOST=http://host.docker.internal:8000
AIRBYTE_WORKSPACE_ID=remplacer_par_workspace_id
AIRBYTE_CLIENT_ID=remplacer_par_client_id
AIRBYTE_CLIENT_SECRET=remplacer_par_client_secret
AIRBYTE_CONNECTION_ID=remplacer_par_connection_id
# dagster_airbyte (officiel) ou rest (appel direct API, secours)
SYNC_MECHANISM=dagster_airbyte

# --- Bases de donnees (utilisees par Dagster et l'API) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpass
MYSQL_DB=shop
PG_DSN=postgresql://postgres:postgrespass@postgres:5432/warehouse
